#!/usr/bin/env bash
# Wire a Qwen API key into openclaw (agent brain) + the trade repo (ts explain).
# Run this once the QWEN_API key in ~/Desktop/Trade-system_v1/.env authenticates.
#
#   ~/trade-ops/bin/wire-qwen [--model qwen-plus] [--endpoint <base-url>]
#
# Default is qwen3-max (Arka: large qwen for summarisation/complex tasks).
# Why qwen-plus is the cheap tier: it is Alibaba's balanced tier — near-max
# reasoning quality at roughly a tenth of qwen-max's price, and far stronger
# than qwen-turbo for the analysis/briefing work Silas does. Override with
# --model qwen-turbo (cheapest) or qwen3-max (strongest) if you prefer.
set -uo pipefail

MODEL="qwen3-max"
ENDPOINT="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model) MODEL="$2"; shift 2;;
    --endpoint) ENDPOINT="$2"; shift 2;;
    *) echo "unknown arg: $1"; exit 2;;
  esac
done

ENVF="/home/ad2688/Desktop/Trade-system_v1/.env"
KEY=$(grep -E "^QWEN_API=" "$ENVF" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' \r\n')
[[ -n "$KEY" ]] || { echo "no QWEN_API in $ENVF"; exit 1; }

echo "1/3 verifying key against $ENDPOINT (model $MODEL)…"
RESP=$(curl -s -m 30 "$ENDPOINT/chat/completions" \
  -H "Authorization: Bearer $KEY" -H "Content-Type: application/json" \
  -d "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: OK\"}],\"max_tokens\":10}")
if ! grep -q '"choices"' <<<"$RESP"; then
  echo "  ✗ key still not authenticating. Response:"; echo "  $(head -c 300 <<<"$RESP")"
  echo "  Fix the key/account first (see notes at the bottom of this script)."
  exit 3
fi
echo "  ✓ authenticated"

echo "2/3 registering provider + model in openclaw…"
cp /home/ad2688/.openclaw/openclaw.json "/home/ad2688/.openclaw/openclaw.json.pre-qwen-$(date +%F)"
KEY="$KEY" MODEL="$MODEL" ENDPOINT="$ENDPOINT" python3 - <<'PY'
import json, os
p = "/home/ad2688/.openclaw/openclaw.json"
d = json.load(open(p))
prov = d.setdefault("models", {}).setdefault("providers", {})
prov["qwen"] = {
    # NOTE: must be "openai-completions" — openclaw rejects "openai-compatible"
    # and the gateway then fails to start (exit 78/CONFIG).
    "api": "openai-completions",
    "apiKey": os.environ["KEY"],
    "baseUrl": os.environ["ENDPOINT"],
    "models": [{
        "id": os.environ["MODEL"],
        "name": os.environ["MODEL"],
        "contextWindow": 131072,
        "maxTokens": 8192,
        "input": ["text"],
        "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
    }],
}
m = d["agents"]["defaults"]["model"]
qwen = f"qwen/{os.environ['MODEL']}"
m["primary"] = qwen
# keep the free local/cloud models as fallbacks; drop the dead deepseek entry
m["fallbacks"] = ["qwen/qwen-plus", "ollama/nemotron-3-ultra:cloud", "ollama/gpt-oss:20b", "ollama/qwen3.5:9b"]
json.dump(d, open(p, "w"), indent=2)
print("   primary =", qwen, "| fallbacks =", m["fallbacks"])
PY

echo "3/3 restarting gateway…"
systemctl --user restart openclaw-gateway; sleep 12
if [[ "$(systemctl --user is-active openclaw-gateway)" != "active" ]]; then
  echo "  ✗ gateway failed to start — rolling back to the pre-qwen config"
  journalctl --user -u openclaw-gateway --since "1 min ago" --no-pager 2>/dev/null \
    | grep -iE "Invalid config|models.providers" | tail -3
  cp "/home/ad2688/.openclaw/openclaw.json.pre-qwen-$(date +%F)" /home/ad2688/.openclaw/openclaw.json
  systemctl --user restart openclaw-gateway; sleep 10
  echo "  rolled back; gateway is now: $(systemctl --user is-active openclaw-gateway)"
  exit 4
fi
echo "  ✓ gateway active on qwen/$MODEL"

cat <<'NOTE'

Done. Telegram/Silas now think on Qwen with the free Ollama models as failover.

Note on `ts explain` / `ts agent-analyze` in the trade repo: those read
DEEPSEEK_API_KEY and hit api.deepseek.com, which is hard-coded in
src/trading_system/decision/explain.py (a TRACKED file — not edited here to
keep this machine merge-clean). Two options on the laptop:
  * quick: point DEEPSEEK_API_KEY at the Qwen key and DEEPSEEK_BASE_URL at the
    DashScope compatible endpoint (they are both OpenAI-shaped), or
  * proper: parameterise the provider in explain.py.

If the key does NOT authenticate, the usual causes are:
  * Alibaba Model Studio not activated for the account (activate in console)
  * key created in the mainland console but used against the -intl endpoint
    (or vice versa) — try --endpoint https://dashscope.aliyuncs.com/compatible-mode/v1
  * free-tier quota not yet granted / billing not enabled
NOTE
