[Unit]
Description=Ollama 0.40.2 (user space) serving tev1 decision models on :11435 for Trade-system_v1
After=network-online.target

[Service]
ExecStart=%h/opt/ollama-0.40.2/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=%h/opt/ollama-models
Environment=OLLAMA_KEEP_ALIVE=10m
Environment=OLLAMA_NUM_PARALLEL=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
